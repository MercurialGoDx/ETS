      m_Items: []
  - m_Id: 1401183729082400
    m_Localized: "\u0423\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
      \u0443\u0440\u043E\u043D \u043E\u0442 \u0448\u0438\u043F\u043E\u0432 \u043D\u0430
      <color=#ffd700>60</color>. \u041F\u043E\u043B\u0443\u0447\u0430\u0439\u0442\u0435
      +2 \u0443\u0440\u043E\u043D\u0430 \u043A \u0448\u0438\u043F\u0430\u043C, \u043A\u0430\u0436\u0434\u044B\u0439
      \u0440\u0430\u0437, \u043A\u043E\u0433\u0434\u0430 \u0432\u0440\u0430\u0433
