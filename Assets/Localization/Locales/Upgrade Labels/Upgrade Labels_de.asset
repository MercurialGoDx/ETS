  - m_Id: 74576184482758692
    m_Localized: 'Gegner werden mit einer Chance von <color=#ffd700>{0}%</color> golden. Goldene Gegner haben <color=#ffd700>x{1}</color> Leben, <color=#ffd700>x{2}</color> Schaden und geben <color=#ffd700>x{3}</color> Gold.\n\n<color=#ffd700>Kosten: {4}</color>'
