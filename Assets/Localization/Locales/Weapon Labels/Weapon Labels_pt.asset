      m_Items: []
  - m_Id: 1385907725787163
    m_Localized: <color=#ffd700>Catapulta</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787164
    m_Localized: "Causa dano em \xE1rea igual a <color=#ffd700>50 + 2%</color> da
      Vida m\xE1xima da torre\\n<color=#ffd700>Dano:</color> {0}\\n<color=#ffd700>Tipo
      de dano:</color> {1}\\n<color=#ffd700>Velocidade de ataque:</color> {2}\\n<color=#ffd700>Dano
      em \xE1rea:</color> Sim\\n\\n<color=#ffd700>Custo:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787165
    m_Localized: "<color=#ffd700>Intimida\xE7\xE3o</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787166
    m_Localized: "Envia uma onda em dire\xE7\xE3o ao inimigo, causando dano a todos
      em seu caminho. Cura a torre em <color=#ffd700>10</color> de vida para cada
      inimigo atingido\\n<color=#ffd700>Dano:</color> {0}\\n<color=#ffd700>Tipo de
      dano:</color> {1}\\n<color=#ffd700>Velocidade de ataque:</color> {2}\\n\\n<color=#ffd700>Custo:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787167
    m_Localized: <color=#ffd700>Martelo da Tempestade</color>
