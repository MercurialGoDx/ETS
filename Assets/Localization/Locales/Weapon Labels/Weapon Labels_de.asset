    m_Localized: <color=#ffd700>Magiefokus</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787170
    m_Localized: <color=#ffd700>Schaden:</color> {0}\n<color=#ffd700>Schadensart:</color>
