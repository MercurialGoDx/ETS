    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787171
    m_Localized: <color=#ffd700>Baumstamm</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787172
    m_Localized: "Schleudert einen Baumstamm auf den Gegner zu, der allen Gegnern
      auf seinem Weg Schaden zuf\xFCgt\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787173
    m_Localized: <color=#ffd700>Tornado</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787174
    m_Localized: "Bei einem Treffer st\xF6\xDFt die Waffe den Gegner vom Turm weg.
      F\xFCgt allen Gegnern auf ihrem Weg Schaden zu. Wechselt nach jedem Schuss
      das Ziel\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787175
    m_Localized: <color=#ffd700>Eissturm</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787176
    m_Localized: "Ein Eissturm st\xFCrzt vom Himmel herab und verursacht Fl\xE4chenschaden\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n<color=#ffd700>Fl\xE4chenschaden:</color> Ja\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787177
    m_Localized: <color=#ffd700>Verdammnisfeuer</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787178
    m_Localized: "Erzeugt eine Feueraura um den Turm, die Gegnern nach und nach Schaden
      zuf\xFCgt\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787179
    m_Localized: <color=#ffd700>Zyklus</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787180
    m_Localized: "Erzeugt eine magische Kraft um den Turm, die allen Gegnern auf
      der Karte Schaden zuf\xFCgt\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787181
    m_Localized: <color=#ffd700>Asteroid</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787182
    m_Localized: "Ein Asteroid st\xFCrzt vom Himmel herab und verursacht hohen Fl\xE4chenschaden\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n<color=#ffd700>Fl\xE4chenschaden:</color> Ja\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787183
    m_Localized: <color=#ffd700>Wirbelnde Klingen</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787184
    m_Localized: "Erzeugt 15 Sekunden lang Klingen an einer zuf\xE4lligen Stelle,
      die Gegnern in ihrer N\xE4he Schaden zuf\xFCgen\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n<color=#ffd700>Fl\xE4chenschaden:</color> Ja\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 75581446427762688
    m_Localized: "<color=#ffd700>Gl\xE4nzer</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 75581446511648768
    m_Localized: "Bei T\xF6tung eines Gegners erh\xE4ltst du zus\xE4tzliches Gold
      <color=#ffd700>+1</color>\\nErh\xE4lt <color=#ffd700>+1</color> Basisschaden
      f\xFCr jeweils <color=#ffd700>300</color> nicht ausgegebenes Gold, bis zu <color=#ffd700>+7</color>\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n\\n<color=#ffd700>Kosten:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 74621472677330944
    m_Localized: <color=#ffd700>Kraftfokus</color>
    m_Metadata:
      m_Items: []
  - m_Id: 74621472828325888
    m_Localized: Jede Sekunde, in der die Waffe dasselbe Ziel angreift, steigt ihr
      Basisschaden um <color=#ffd700>100%</color>, bis zu <color=#ffd700>500%</color>\n<color=#ffd700>Schaden:</color>
      {0}\n<color=#ffd700>Schadensart:</color> {1}\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\n\n<color=#ffd700>Kosten:</color>  {3}
    m_Metadata:
      m_Items: []
  - m_Id: 74605534590566400
    m_Localized: <color=#ffd700>Versuchung</color>
    m_Metadata:
      m_Items: []
  - m_Id: 74605534649286656
    m_Localized: "Jedes Mal, wenn diese Waffe einen Gegner t\xF6tet, erhalten alle
      Exemplare von <color=#ffd700>\"Versuchung\"</color> <color=#ffd700>+0.2</color>
      Basisschaden\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
