      m_Items: []
  - m_Id: 1385907725787148
    m_Localized: "Bei einem Treffer springt die Waffe zum n\xE4chsten Gegner, wenn
      dieser in Reichweite ist. <color=#ffd700>Wiederholt sich 3-mal</color>\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n\\n<color=#ffd700>Kosten:</color>  {3}"
