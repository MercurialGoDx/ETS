    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787163
    m_Localized: <color=#ffd700>Katapult</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787164
    m_Localized: "Verursacht Fl\xE4chenschaden in H\xF6he von <color=#ffd700>50 +
      2%</color> der maximalen Gesundheit des Turms\\n<color=#ffd700>Schaden:</color>
      {0}\\n<color=#ffd700>Schadensart:</color> {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color>
      {2}\\n<color=#ffd700>Fl\xE4chenschaden:</color> Ja\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787165
    m_Localized: "<color=#ffd700>Einsch\xFCchterung</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787166
    m_Localized: "Sendet eine Welle auf den Gegner zu, die allen Gegnern auf ihrem
      Weg Schaden zuf\xFCgt. Heilt den Turm um <color=#ffd700>10</color> Gesundheit
      f\xFCr jeden getroffenen Gegner\\n<color=#ffd700>Schaden:</color> {0}\\n<color=#ffd700>Schadensart:</color>
      {1}\\n<color=#ffd700>Angriffsgeschwindigkeit:</color> {2}\\n\\n<color=#ffd700>Kosten:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787167
    m_Localized: <color=#ffd700>Sturmhammer</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787168
