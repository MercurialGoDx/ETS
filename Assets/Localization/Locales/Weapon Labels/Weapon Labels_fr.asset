      m_Items: []
  - m_Id: 1385907725787171
    m_Localized: <color=#ffd700>Rondin</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787172
    m_Localized: "Lance un rondin vers l'ennemi, infligeant des d\xE9g\xE2ts \xE0
      tous ceux qu'il traverse\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type
      de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787173
    m_Localized: <color=#ffd700>Tornade</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787174
    m_Localized: "\xC0 l'impact, repousse l'ennemi loin de la tour. Inflige des d\xE9g\xE2ts
      \xE0 tous les ennemis sur son passage. Change de cible apr\xE8s chaque tir\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787175
    m_Localized: "<color=#ffd700>Temp\xEAte de glace</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787176
    m_Localized: "Une temp\xEAte de glace s'abat du ciel et inflige des d\xE9g\xE2ts
      de zone\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type de
      d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n<color=#ffd700>D\xE9g\xE2ts
      de zone:</color> Oui\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787177
    m_Localized: <color=#ffd700>Feu funeste</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787178
    m_Localized: "Cr\xE9e une aura de feu autour de la tour qui inflige progressivement
      des d\xE9g\xE2ts aux ennemis\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type
      de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787179
    m_Localized: <color=#ffd700>Cycle</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787180
    m_Localized: "Cr\xE9e une force magique autour de la tour qui inflige des d\xE9g\xE2ts
      \xE0 tous les ennemis sur la carte\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type
      de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787181
    m_Localized: "<color=#ffd700>Ast\xE9ro\xEFde</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787182
    m_Localized: "Un ast\xE9ro\xEFde s'abat du ciel et inflige de lourds d\xE9g\xE2ts
      de zone\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type de
      d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n<color=#ffd700>D\xE9g\xE2ts
      de zone:</color> Oui\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787183
    m_Localized: <color=#ffd700>Lames tournoyantes</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787184
    m_Localized: "Cr\xE9e des lames \xE0 un endroit al\xE9atoire pendant 15 secondes,
      infligeant des d\xE9g\xE2ts aux ennemis alentour\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n<color=#ffd700>D\xE9g\xE2ts de zone:</color> Oui\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 75581446427762688
    m_Localized: <color=#ffd700>Brillant</color>
    m_Metadata:
      m_Items: []
  - m_Id: 75581446511648768
    m_Localized: "\xC0 chaque ennemi tu\xE9, accorde de l'or suppl\xE9mentaire <color=#ffd700>+1</color>\\nGagne
      <color=#ffd700>+1</color> de d\xE9g\xE2ts de base pour chaque <color=#ffd700>300</color>
      pi\xE8ces d'or non d\xE9pens\xE9es, jusqu'\xE0 <color=#ffd700>+7</color>\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 74621472677330944
    m_Localized: <color=#ffd700>Concentration de puissance</color>
    m_Metadata:
      m_Items: []
  - m_Id: 74621472828325888
    m_Localized: "Chaque seconde pass\xE9e sur la m\xEAme cible augmente les d\xE9g\xE2ts
      de base de l'arme de <color=#ffd700>100%</color>, jusqu'\xE0 <color=#ffd700>500%</color>\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 74605534590566400
    m_Localized: <color=#ffd700>Tentation</color>
    m_Metadata:
      m_Items: []
  - m_Id: 74605534649286656
    m_Localized: "Chaque fois que cette arme tue un ennemi, tous les exemplaires
      de <color=#ffd700>\"Tentation\"</color> gagnent <color=#ffd700>+0.2</color>
      de d\xE9g\xE2ts de base\\n<color=#ffd700>D\xE9g\xE2ts:</color> {0}\\n<color=#ffd700>Type
      de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
