    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787163
    m_Localized: <color=#ffd700>Catapulte</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787164
    m_Localized: "Inflige des d\xE9g\xE2ts de zone \xE9gaux \xE0 <color=#ffd700>50
      + 2%</color> de la Sant\xE9 maximale de la tour\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n<color=#ffd700>D\xE9g\xE2ts de zone:</color> Oui\\n\\n<color=#ffd700>Co\xFBt:</color> 
      {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787165
    m_Localized: <color=#ffd700>Intimidation</color>
    m_Metadata:
      m_Items: []
  - m_Id: 1385907725787166
    m_Localized: "Envoie une onde vers l'ennemi, infligeant des d\xE9g\xE2ts \xE0
      tous ceux qu'elle traverse. Soigne la tour de <color=#ffd700>10</color> points
      de sant\xE9 pour chaque ennemi touch\xE9\\n<color=#ffd700>D\xE9g\xE2ts:</color>
      {0}\\n<color=#ffd700>Type de d\xE9g\xE2ts:</color> {1}\\n<color=#ffd700>Vitesse
      d'attaque:</color> {2}\\n\\n<color=#ffd700>Co\xFBt:</color>  {3}"
    m_Metadata:
      m_Items: []
