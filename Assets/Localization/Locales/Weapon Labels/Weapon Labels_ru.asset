  - m_Id: 74621472828325888
    m_Localized: "\u041A\u0430\u0436\u0434\u0443\u044E \u0441\u0435\u043A\u0443\u043D\u0434\u0443,
      \u043F\u043E\u043A\u0430 \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0435
      \u043F\u043E\u043C\u0435\u043D\u044F\u0435\u0442 \u0446\u0435\u043B\u044C,
      \u0431\u0430\u0437\u043E\u0432\u044B\u0439 \u0443\u0440\u043E\u043D \u043E\u0440\u0443\u0436\u0438\u044F
      \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u043D\u0430 <color=#ffd700>100%</color>, \u0432\u043F\u043B\u043E\u0442\u044C
      \u0434\u043E <color=#ffd700>500%</color>\\n<color=#ffd700>\u0423\u0440\u043E\u043D:</color>
      {0}\\n<color=#ffd700>\u0422\u0438\u043F \u0443\u0440\u043E\u043D\u0430:</color>
