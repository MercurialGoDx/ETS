      m_Calls: []
  m_text: "\u0414\u043E\u0431\u0440\u043E \u043F\u043E\u0436\u0430\u043B\u043E\u0432\u0430\u0442\u044C!\n\n\u041A\u0430\u0436\u0434\u044B\u0435
    10 \u0441\u0435\u043A\u0443\u043D\u0434 \u043F\u0440\u0438\u0445\u043E\u0434\u044F\u0442
    \u0432\u043E\u043B\u043D\u044B \u0432\u0440\u0430\u0433\u043E\u0432: \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E,
    \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u0438 \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E
    \u0431\u043E\u044F.\n\u041A\u0430\u0436\u0434\u044B\u0435 5 \u043C\u0438\u043D\u0443\u0442
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0431\u043E\u0441\u0441
    \u2014 \u0437\u0430 \u043D\u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u0443\u044E \u043D\u0430\u0433\u0440\u0430\u0434\u0443.\n\u0412\u0440\u0430\u0433\u0438
    \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0441\u043E
    \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C. \u0426\u0435\u043B\u044C \u2014
    \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0430\u0442\u044C\u0441\u044F \u043A\u0430\u043A
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u043B\u044C\u0448\u0435!"
