  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b1f35ae79b4fbc9459bff31bcee95abd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  title: "<color=#ffd700>\u041E\u0431\u043D\u043E\u0432\u0438\u0442\u044C \u043C\u0430\u0433\u0430\u0437\u0438\u043D</color>"
  description: "\u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D, \u0437\u0430\u043F\u043E\u043B\u043D\u044F\u0435\u0442
    \u043F\u0443\u0441\u0442\u044B\u0435 \u044F\u0447\u0435\u0439\u043A\u0438 \u0438
    \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442 \u0441\u0442\u0430\u0440\u044B\u0435,
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u043D\u0435 \u0431\u044B\u043B\u0438
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u044B\n\u0413\u043E\u0440\u044F\u0447\u0430\u044F
    \u043A\u043B\u0430\u0432\u0438\u0448\u0430 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u044F:
    <color=#ffd700>R</color>\n\u041E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430 \u0442\u0430\u043A\u0436\u0435
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u043A\u0430\u0436\u0434\u044B\u0435
    <color=#ffd700>30</color> \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u0435\u0437\u0430\u0432\u0438\u0441\u0438\u043C\u043E
    \u043E\u0442 \u0438\u0433\u0440\u043E\u043A\u0430, \u0442\u0430\u043A\u043E\u0435
    \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435 \u043D\u0435 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
    \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C \u0438 \u043D\u0435 \u0442\u0440\u0430\u0442\u0438\u0442
    \u0437\u043E\u043B\u043E\u0442\u043E"
  shopManager: {fileID: 0}
